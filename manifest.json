{
  "manifest_version": 3,
  "name": "FixablyExtention by Kustov Aleksey",
  "version": "1.0.0",
  "description": "Make use more comfortable for Fixably users",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://rev-photographers-stranger-chest.trycloudflare.com/*",
    "https://evy.fixably.com/*"
],
  "update_url": "https://raw.githubusercontent.com/sempl911/fixmod/main/updates.xml",
  "icons": {
    "16": "fixIco/fixModIco_16.png",
    "32": "fixIco/fixModIco_32.png",
    "48": "fixIco/fixModIco_48.png",
    "64": "fixIco/fixModIco_64.png",
    "128": "fixIco/fixModIco_128.png",
    "256": "fixIco/fixModIco_256.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Настройки виджета"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://evy.fixably.com/*"],
      "js": ["content.js", "quick-input.js", "device-photos.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["suggestions.json"],
      "matches": ["https://evy.fixably.com/*"]
    }
  ]
}