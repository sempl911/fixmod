# === Стандартная секция (Node / JavaScript) ===

# Зависимости (тысячи файлов, не нужны в Git)
node_modules/
jspm_packages/

# Папки сборки и кэш (генерируются на лету)
dist/
build/
out/
.sass-cache/
*.log
npm-debug.log*

# IDE и системные файлы (конфиги вашего локального редактора)
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Переменные окружения (пароли/токены)
.env
.env.local
.env.*.local

# === Специфичная секция для Chrome Extension ===

# БЕЗОПАСНОСТЬ: Закрытый ключ расширения (НИКОГДА НЕ УДАЛЯТЬ ЭТУ СТРОКУ!)
*.pem

# Упакованные версии расширения (тяжелые бинарники)
*.crx
*.zip